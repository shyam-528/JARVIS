# Placeholder-only configuration for api.public:app.
# These variables are NOT loaded from the desktop .env automatically.
# Set them through your host's secret manager or your shell.
JARVIS_WEB_ORIGIN=https://your-domain.example
JARVIS_WEB_SECURE_COOKIES=1
JARVIS_WEB_SIGNUP=1
JARVIS_WEB_DAILY_LIMIT=100
JARVIS_WEB_DB=data/public_web.db
# An OpenAI-compatible chat/completions endpoint (HTTPS required).
JARVIS_WEB_PROVIDER_URL=https://api.openai.com/v1
JARVIS_WEB_PROVIDER_KEY=replace-with-a-server-side-key
JARVIS_WEB_MODEL=replace-with-your-provider-model-id
